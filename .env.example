# AnxioCare API configuration. Validated at boot by apps/api/src/config.ts; the server refuses to
# start on anything invalid. No real values belong in this file. `npm run generate-secrets -w @anxiocare/api`
# prints fresh keys and the SQL for the runtime role. For local work you need none of this:
# `npm run dev:api` sets everything up by itself.

# development | test | production. Production adds stricter checks (https origin, SMTP, CA, ...).
NODE_ENV=production

# The exact origin the app is served from: scheme and host, no path or trailing slash. CSRF checks compare against it.
PUBLIC_ORIGIN=https://example.onrender.com

# Listen address. Render sets PORT itself.
# HOST=0.0.0.0
# PORT=8787

# A header holding the client address, set by a proxy that overwrites it on every request. On Render, Cloudflare
# does this for cf-connecting-ip (see apps/api/README.md). Do not set it unless every request passes through
# such a proxy: otherwise clients can forge it. When absent or invalid, hop counting below is used.
# CLIENT_IP_HEADER=cf-connecting-ip

# How many proxies sit in front of the app and append to X-Forwarded-For. Sets which address counts as the
# client for rate limiting. Too low: everyone shares one limit. Too high: clients can spoof their address.
TRUST_PROXY_HOPS=1

# fatal | error | warn | info | debug | silent
LOG_LEVEL=info

# Least-privilege runtime role (anxiocare_runtime). Supabase session pooler (port 5432), Mumbai region:
#   postgres://anxiocare_runtime.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Migration role, used only by `npm run migrate`. render.yaml starts the server without it. See docs/SECURITY-EXCEPTIONS.md.
DATABASE_MIGRATION_URL=

# PEM of the database CA, or base64 of the PEM. Mandatory in production: connections use TLS verify-full.
DATABASE_CA_CERT=

# Connections held by each instance.
# DATABASE_POOL_MAX=5

# Master keys that wrap each user's data key: comma-separated <version>:<base64 of 32 random bytes>.
# Losing these makes all user data permanently unreadable. Keep a copy in a separate secret store.
ENCRYPTION_KEYS=
# Which version wraps new keys.
ENCRYPTION_ACTIVE_KEY=v1

# Each is base64 of 32 random bytes, and each must be different.
# Blind index for email lookups. Cannot be rotated without re-hashing, because the plain addresses are encrypted.
EMAIL_INDEX_KEY=
# Pepper for sign-in code HMACs. Rotating it only invalidates live codes.
OTP_PEPPER=
# Pseudonymises the actor in audit rows.
AUDIT_KEY=

# smtp in production. file:<path> is for development and e2e only, and refused in production.
MAIL_TRANSPORT=smtp
# Keep the sender neutral: it appears on lock screens. Production refuses a name or address that reveals the subject,
# so the domain must not name the service or its subject either.
MAIL_FROM=no-reply@example.com
# The sender's display name. Default: "Account Team".
# MAIL_FROM_NAME=Account Team
# Named in the privacy notice as who handles email. Default: "our email provider".
MAIL_PROVIDER=
SMTP_HOST=
# 587 uses required STARTTLS, 465 implicit TLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Shown in the Privacy and Terms pages through GET /api/v1/meta.
OPERATOR_NAME=
GRIEVANCE_EMAIL=

# Stated in the privacy notice and the delete-account screen. OWNER TO CONFIRM against your Supabase plan:
# Pro keeps 7 days of daily backups, Team 14, Enterprise up to 30.
# BACKUP_RETENTION_DAYS=7
# Stated in the privacy notice. Change them if you deploy elsewhere.
# DATA_LOCATION=Mumbai, India
# SERVER_LOCATION=Singapore

# Development only: extra origins allowed by the CSRF check, comma-separated. Refused in production.
# DEV_ORIGINS=http://localhost:5173

# Where the built web app is. Defaults to apps/web/dist.
# WEB_DIST=
