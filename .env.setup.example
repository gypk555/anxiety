# For `npm run db:setup` and `npm run db:verify`. Copy to .env.setup, which git ignores, and fill it in.
# These stay on your machine. Never paste them into a chat, an issue or a log.

# Your database's admin connection string. On Supabase: Project Settings, Database, Session pooler (port 5432), with
# the postgres role and its password. Percent-encode any special characters in the password.
ADMIN_DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# The database's CA certificate. On Supabase: Project Settings, Database, SSL configuration, Download certificate.
# Relative to this file. TLS is always verified against it.
DATABASE_CA_PATH=./supabase-ca.crt

# Where db:setup keeps the generated app secrets. Git ignores it. It is created once, and never overwritten.
# SECRETS_FILE=.env.secrets
