{
  "name": "anxiocare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.7" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:api": "npm run dev -w @anxiocare/api",
    "dev:web": "npm run dev -w @anxiocare/web",
    "build": "npm run build -w @anxiocare/web && npm run build -w @anxiocare/api",
    "start": "npm run start -w @anxiocare/api",
    "migrate": "npm run migrate -w @anxiocare/api",
    "db:setup": "npm run db:setup -w @anxiocare/api --",
    "db:verify": "npm run db:verify -w @anxiocare/api",
    "doctor": "npm run doctor -w @anxiocare/api --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @anxiocare/web"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.0"
  }
}
